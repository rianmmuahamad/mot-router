mixed-port: 7890
allow-lan: false
bind-address: 127.0.0.1
mode: rule
log-level: warning
external-controller: 127.0.0.1:9090
unified-delay: true
tcp-concurrent: true
find-process-mode: off
profile:
  store-selected: true
proxy-providers:
{{PROVIDERS}}
proxy-groups:
  - name: MOT
    type: select
    use: [{{GROUP_USE}}]
    proxies: [DIRECT]
rules:
  - MATCH,MOT
