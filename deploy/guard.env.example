# /etc/mot-router/guard.env  (chmod 600, root-only)
#
# The master key is the single credential guard presents to mot-router. It is
# created once and never handed to a user:
#   curl -s -X POST http://127.0.0.1:8787/api/keys \
#        -H 'Content-Type: application/json' -d '{"name":"motgate"}'
GUARD_MASTER_KEY=replace-with-mr_key
