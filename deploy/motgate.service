[Unit]
Description=motgate portal — user endpoint, admin console, per-user keys
After=network-online.target guard.service mot-router.service
Wants=network-online.target

[Service]
Type=simple
User=motgate
Group=motgate
WorkingDirectory=/opt/mot-router/tools/motgate
EnvironmentFile=/etc/mot-router/motgate.env
ExecStart=/opt/mot-router/tools/motgate/motgate \
    --host 127.0.0.1 --port 8790 \
    --data /var/lib/motgate \
    --upstream http://127.0.0.1:8791 \
    --public-url https://arbyte.coddx.store
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=motgate
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
